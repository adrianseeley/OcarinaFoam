// Turbulent thermal diffusivity field in the compressible formulation, initially zero.
// All patches use zeroGradient. This is solver support data, not particle transparency;
// renderer alpha is computed separately from changes in each visualised field.

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    airSource
    {
        type                zeroGradient;
    }

    atmosphere
    {
        type                zeroGradient;
    }

    solidWalls
    {
        type                zeroGradient;
    }
}

