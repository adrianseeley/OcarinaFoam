// BASELINE: STATIC BODY-FITTED MESH, NO ADAPTIVE REMESHING
// Castellation selects/refines cells; snapping moves their boundary toward the STL.
// Explicit feature edges protect sharp geometry such as the labium. Surface level L
// roughly halves the coarse spacing L times; min/max surface levels and the feature
// level are independent inputs. Distance bands refine a surrounding volume so the
// jet is not resolved only exactly on the wall. nCellsBetweenLevels controls how
// quickly refinement transitions across neighbouring cells.
// 
// locationInMesh sits in the retained exterior air above the body (+Z), off every cell
// face at all refinement levels. Only the connected fluid component
// containing it is retained. The chamber must connect through real openings; a sealed
// or accidentally plugged cavity is not an acoustic cavity in the generated mesh.
// Refinement does not repair a malformed STL or guarantee resolution of a narrow gap.
// 
// No prism layers: this keeps thin throat/labium meshing predictable at this stage.
// Adding layers may better resolve wall gradients but can collapse in narrow passages
// and requires explicit thickness/growth/y+ studies. Dynamic mesh refinement would
// invalidate the renderer's fixed mesh-to-field cell ordering and is unsupported.
// 
// The current cell ceilings are label limits, NOT memory budgets. Provision RAM from
// measured mesh size and refine cautiously. Increasing surface levels can multiply
// cell counts steeply. Build runs mesh utilities serially; only the final solver mesh
// is decomposed. This avoids extra intermediate parallel/reconstruction workflows.
// 
// Explicit feature snapping is on; implicit snapping is off. Patch smoothing, snapping
// iterations/tolerance, feature angle and quality limits below form the baseline recipe.
// They are not interchangeable performance knobs: changing them changes the generated
// mesh. Negative area/triangle-twist limits disable those checks. checkMesh must still
// report Mesh OK with full topology and standard geometry checks before decomposition.
// Its optional -allGeometry mode rejects concave polyhedra even when quality limits pass.

// Refine and snap the background air mesh to the solid body; no prism layers are added.
// Keep the connected fluid containing locationInMesh, which the builder places in the
// exterior air above the body; it connects through the voicing to chamber and throat. A sealed cavity disconnected from that point will not be retained.
// Both STL and extracted features are already in metres.
// Quality thresholds guide snapping but checkMesh remains necessary on the result.

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    solidBody.stl
    {
        type    triSurfaceMesh;
        name    solidWalls;
        scale   1;
    }
}

castellatedMeshControls
{
    // Effectively unlimited: 2147483647 is the largest portable label value.
    // These integer ceilings impose no practical memory budget; refinement can exhaust RAM.
    maxLocalCells       2147483647;
    maxGlobalCells      2147483647;
    minRefinementCells  0;
    nCellsBetweenLevels {{N_CELLS_BETWEEN_LEVELS}};

    features
    (
        {
            file    "solidBody.eMesh";
            level   {{FEATURE_REFINEMENT_LEVEL}};
        }
    );

    refinementSurfaces
    {
        solidWalls
        {
            level ({{SURFACE_REFINEMENT_MIN_LEVEL}} {{SURFACE_REFINEMENT_MAX_LEVEL}});
            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
{{DISTANCE_REFINEMENT_REGIONS}}
    }

    // Surface curvature criterion, independent of the extracted-edge included angle.
    resolveFeatureAngle 30;
    locationInMesh      ({{LOCATION_IN_MESH}});
    allowFreeStandingZoneFaces true;
}

snapControls
{
    // Smooth the surface patch before snapping to reduce skewed and concave cells.
    nSmoothPatch   3;
    tolerance      2.0;
    nSolveIter     30;
    nRelaxIter     5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
    }
}

// Limits below constrain cell shape/volume during snapping. Negative minArea and
// minTriangleTwist disable those particular lower-bound checks; values are not
// recommended universal tolerances for every geometry.
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness  20;
    maxInternalSkewness  4;
    maxConcave           80;
    minVol               1e-13;
    minTetQuality        1e-30;
    minArea              -1;
    minTwist             0.02;
    minDeterminant       0.001;
    minFaceWeight        0.02;
    minVolRatio          0.01;
    minTriangleTwist     -1;
    nSmoothScale         4;
    errorReduction       0.75;
}

debug 0;
mergeTolerance 1e-6;
