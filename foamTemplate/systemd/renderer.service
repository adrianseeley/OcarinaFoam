# Headless .NET file-based renderer; SDK and package restore are needed at startup.
# WorkingDirectory resolves the relative font path. Lower CPU/I/O priority favours
# simulation progress but cannot reserve RAM. on-failure retries do not preserve
# in-memory queue/deletion state; inspect failed or interrupted frames after restart.
# This unit has no dependency on the solver unit: mesh/decomposition must exist first.

[Unit]
Description=OpenFOAM frame renderer for {{CASE_NAME}}
After=local-fs.target

[Service]
Type=simple
User={{CASE_OWNER}}
WorkingDirectory={{SYSTEMD_CASE_DIRECTORY}}
ExecStart=/usr/bin/dotnet run --file render/FoamRenderer.cs -c Release
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
