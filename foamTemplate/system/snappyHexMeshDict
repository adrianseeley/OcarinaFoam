// BASELINE: STATIC BODY-FITTED MESH, NO REFINEMENT, FIXED CELL SIZE
// Castellation selects/removes cells inside the solid; snapping moves boundary vertices toward the STL.
// No refinement levels: the mesh uses a uniform fixed cell size throughout the domain.
// 
// locationInMesh sits in the retained exterior air above the body (+Z), off every cell
// face. Only the connected fluid component containing it is retained. The chamber must connect
// through real openings; a sealed or accidentally plugged cavity is not an acoustic cavity
// in the generated mesh.
// 
// No prism layers: this keeps thin throat/labium meshing predictable at this stage.
// Dynamic mesh refinement would invalidate the renderer's fixed mesh-to-field cell ordering
// and is unsupported.
// 
// Feature snapping is disabled; snapping relies on surface patch smoothing and iteration controls.
// checkMesh must still report Mesh OK with full topology and standard geometry checks before decomposition.

// Snap the background air mesh to the solid body; no refinement or prism layers are added.
// Keep the connected fluid containing locationInMesh, which the builder places in the
// exterior air above the body; it connects through the voicing to chamber and throat.
// Both STL coordinates and mesh are in metres.
// Quality thresholds guide snapping but checkMesh remains necessary on the result.

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    solidBody.stl
    {
        type    triSurfaceMesh;
        name    solidWalls;
        scale   1;
    }
}

castellatedMeshControls
{
    // Effectively unlimited: 2147483647 is the largest portable label value.
    // These integer ceilings impose no practical memory budget.
    maxLocalCells       2147483647;
    maxGlobalCells      2147483647;
    minRefinementCells  0;
    nCellsBetweenLevels 1;

    features
    (
    );

    refinementSurfaces
    {
        solidWalls
        {
            level (0 0);
            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
    }

    // Surface curvature criterion, independent of the extracted-edge included angle.
    resolveFeatureAngle 30;
    locationInMesh      ({{LOCATION_IN_MESH}});
    allowFreeStandingZoneFaces true;
}

snapControls
{
    // Smooth the surface patch before snapping to reduce skewed and concave cells.
    nSmoothPatch   3;
    tolerance      2.0;
    nSolveIter     30;
    nRelaxIter     5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
    }
}

// Limits below constrain cell shape/volume during snapping. Negative minArea and
// minTriangleTwist disable those particular lower-bound checks; values are not
// recommended universal tolerances for every geometry.
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness  20;
    maxInternalSkewness  4;
    maxConcave           80;
    minVol               1e-13;
    minTetQuality        1e-30;
    minArea              -1;
    minTwist             0.02;
    minDeterminant       0.001;
    minFaceWeight        0.02;
    minVolRatio          0.01;
    minTriangleTwist     -1;
    nSmoothScale         4;
    errorReduction       0.75;
}

debug 0;
mergeTolerance 1e-6;
